[[ ${0} == ${BASH_SOURCE}  ]] && exit 0

# Source once
[[ -n ${__fwfunctions:-} ]] && return 0
readonly __fwfunctions="$(readlink -f "$BASH_SOURCE")"


init_fw() {

    local dir file
    [[ -d "$logdir" ]] || mkdir -p "$logdir"
    [[ -f "${logdir}"/"${logfile}" ]] || touch "${logdir}"/"${logfile}"

    [[ -d /run/"${SCRIPT_NAME}" ]] || mkdir -p /run/"${SCRIPT_NAME}"
    [[ -f /run/"${SCRIPT_NAME}"/maintenance.pid ]] || echo 0 > /run/"${SCRIPT_NAME}"/maintenance.pid

    [[ -d "$confdir" ]] || mkdir -p "$confdir"
    [[ -d "$oldconfdir" ]] || mkdir -p "$oldconfdir"

    for dir in "$confdir" "$oldconfdir"; do

        for file in \
            "$nat_11_file" \
            "$nat_1n_ip_file" \
            "$public_ip_file" \
            "$routed_nets_file" \
            "$blacklist_file" \
            "$lan_banned_dst_ports_file" \
            "$shaper_file" \
            "$dhcp_conf_file" \
            "$lan_ddos_protected_ports_file" \
            "$wan_banned_dst_ports_file" \
            "$lan_operator_file" \
            "$wan_operator_file"
        do
            [[ -f "$dir/$file" ]] || touch "$dir/$file"
        done
    done
    ln -sf "$confdir"/"$dhcp_conf_file" /etc/dhcp/"$dhcp_conf_file"
}

__printmessage() {
    if [[ "$level" == "error" ]]; then
        printf '%s%s%s\n' "$COLOR_RED" "$MESSAGE_FORMAT_SIMPLE" "$COLOR_RESET" >&2
    else
        printf '%s\n' "$MESSAGE_FORMAT_SIMPLE"
    fi
}


Log() {
    local message="${*:2}"
    local level="$1"
    local logdate

    logdate=$(date +"%F %T.%3N%:z")

    local MESSAGE_FORMAT="${logdate} - ${level}: ${message}"
    local MESSAGE_FORMAT_SIMPLE="${message}"

    local COLOR_RED=$'\033[0;31m'
    local COLOR_RESET=$'\033[0m'

    local logger_level

    case "$level" in
        error) logger_level="err" ;;
        *)     logger_level="$level" ;;
    esac

    logger -p "user.${logger_level}" -t "${SCRIPT_NAME}" "${message}"

    if [[ "$DEBUG" == "true" || "$DEBUG" == "yes" ]]; then
        __printmessage
        printf '%s\n' "$MESSAGE_FORMAT" >> "$logdir/$logfile"
    else
        if [[ "$level" == "error" || "$level" == "info" ]]; then
            __printmessage
        fi
    fi
}


check_interfaces_up() {
    for iface in "$@"; do
        if [[ ! -e "/sys/class/net/$iface/operstate" ]]; then
            #echo "Interface $iface does not exist — aborting."
            return 1
        fi
        read -r state < "/sys/class/net/$iface/operstate"
        if [[ "$state" != "up" ]]; then
            #echo "Interface $iface is not up — aborting."
            return 1
        fi
    done
    return 0
}

get_config() {
    Log "debug" "Connecting to LMS and downloading configuration files"
    "$copy_cmd_url"/* "${FW_CONFIG_TEMP_DIR}" || { Log "error" "Can not download config files"; exit 1; }

    cd "$confdir" || { Log "error" "Cannot change directory to $confdir"; exit 1; }

    shopt -s nullglob
    for FILENAME in *
    do
        mv "$FILENAME" "$oldconfdir"/"$FILENAME" || { Log "error" "Can not move old config file $FILENAME to $oldconfdir/$FILENAME"; exit 1; }
    done
    shopt -u nullglob

    cp "${FW_CONFIG_TEMP_DIR}"/* "$confdir"/ || { Log "error" "Can not copy new config files to curent config"; exit 1; }
    Log "debug" "get_config OK"
}

get_shaper_config() {
    Log "debug" "The LMS generates a configuration for the Shaper"
    "$exec_cmd" "timeout 10 $lmsd -q -i $lmsd_shaper_instance -h $lms_dbhost:3306 -H $lmsd_host -u $lms_dbuser -d $lms_db" || { Log "error" "Can not connect to database"; exit 1; }
    Log "debug" "Waiting a few seconds"
    sleep 5
    mv "$confdir"/"$shaper_file" "$oldconfdir"/"$shaper_file"
    Log "debug" "Connecting to the server and download the configuration file for Shaper"
    "$copy_cmd_url"/"$shaper_file" "$confdir"/ || { Log "error" "Can not download shaper config file - $shaper_file"; mv $oldconfdir/$shaper_file $confdir/; exit 1; }
    Log "debug" "get_shaper_config OK"
}

lmsd_reload() {
    Log "debug" "Reloading $lmsd_host instances on $lms_ip"
    "$exec_cmd" "$lmsd -q -h $lms_dbhost:3306 -H $lmsd_host -u $lms_dbuser -d $lms_db" || { Log "error" "Can not connect to database"; exit 1; }
    Log "debug" "Reload $lmsd_host instances on $lms_ip complited"
    sleep 5
}

dhcp_server_cmd() {
    if [[ -f /etc/os-release ]]; then
        distro_id="$(grep '^ID=' /etc/os-release | cut -d= -f2 | tr -d '"')"
    fi
    local arg="$1"
    if [[ "$distro_id" == "debian" || "$distro_id" == "ubuntu" ]]; then
        systemctl "$arg" isc-dhcp-server > /dev/null 2>&1 || return 1
    elif [[ "$distro_id" == "almalinux" || "$distro_id" == "fedora" || "$distro_id" == "rhel" || "$distro_id" == "rocky" ]]; then
        systemctl "$arg" dhcpd > /dev/null 2>&1 || return 1
    elif [[ "$distro_id" == "arch" ]]; then
        systemctl "$arg" dhcpd4 > /dev/null 2>&1 || return 1
    else
        Log "debug" "Unknown Linux distro: $distro_id"
    fi
}

dhcpd_cmd() {
    local arg="$1"
    if [ "$arg" = "restart" ]; then
        dhcpd_conf_current=$(cat $confdir/$dhcp_conf_file |sha1sum)
        dhcpd_conf_new=$(cat $oldconfdir/$dhcp_conf_file |sha1sum)
        if [ "$dhcpd_conf_current" != "$dhcpd_conf_new" ]; then
            Log "info" "The dhcpd.conf file has a new configuration, restarting the DHCP SERVER"
            dhcp_server_cmd restart
        else
            Log "debug" "Configuration of dhcpd.conf is identical, restart is not needed"
        fi
    elif [ "$arg" = "start" ]; then
        dhcp_server_cmd start || { Log "error" "The DHCP SERVER start failed"; return 1; }
        Log "info" "The dhcpd server successfully started OK"

    elif [ "$arg" = "stop" ]; then
        dhcp_server_cmd stop || { Log "error" "The DHCP SERVER start failed"; return 1; }
        Log "info" "The dhcpd server successfully stopped OK"
    fi
}

get_counters() {
    mapfile -t CO < <(iptables -t mangle -w 2 -nL FORWARD | awk '/COUNTERSOUT/{print $1}')
    mapfile -t CI < <(iptables -t mangle -w 2 -nL FORWARD | awk '/COUNTERSIN/{print $1}')

    if [[ "${#CO[@]}" == "${#CI[@]}" ]]; then

        join \
            <(for chain in "${CO[@]}"; do
                iptables -t mangle -w 1 -nvxL "$chain" \
                | awk 'NR>2 && $8!="0.0.0.0" {print $8, $2}'
                iptables -t mangle -Z "$chain"
              done | sort -V) \
            <(for chain in "${CI[@]}"; do
                iptables -t mangle -w 1 -nvxL "$chain" \
                | awk 'NR>2 && $9!="0.0.0.0" {print $9, $2}'
                iptables -t mangle -Z "$chain"
              done | sort -V) \
        | grep -v " 0 0"
    fi
}

shaper_cmd() {
    if [ "$1" = "restart" ]; then
        shaper_current=$(cat $confdir/$shaper_file |sha1sum)
        shaper_new=$(cat $oldconfdir/$shaper_file |sha1sum)
        if [ "$shaper_current" != "$shaper_new" ]; then
            Log "info" "Shaper has a new configuration, restarting Shaper"
            sleep 5
            shaper_cmd stop
            shaper_cmd start
        else
            Log "debug" "The Shaper configuration is identical, a restart is not needed"
        fi

    elif [ "$1" = "stop" ]; then
        if check_interfaces_up "$LAN"; then
            tc qdisc del dev $LAN root 2> /dev/null
        fi
        if check_interfaces_up "$WAN"; then
            tc qdisc del dev $WAN root 2> /dev/null
        fi
        iptables -t mangle -F
        iptables -t mangle -X

    elif [ "$1" = "start" ]; then
        shaper_cmd stop
        if ! check_interfaces_up "$WAN" "$LAN"; then
            Log "error" "Interface check failed: skipping traffic shaping configuration."
            return 1
        fi
        delimiter=$IFS
        while IFS='=' read arg1 arg2; do
                case "$arg1" in
                LAN_INTERFACE_SPEED_LIMIT)        LAN_INTERFACE_SPEED_LIMIT=$arg2 ;;
                ISP_RX_LIMIT)                     ISP_RX_LIMIT=$arg2 ;;
                ISP_TX_LIMIT)                     ISP_TX_LIMIT=$arg2 ;;
                LAN_UNCLASSIFIED_RATE_LIMIT)      LAN_UNCLASSIFIED_RATE_LIMIT=$arg2 ;;
                LAN_UNCLASSIFIED_CEIL_LIMIT)      LAN_UNCLASSIFIED_CEIL_LIMIT=$arg2 ;;
                WAN_UNCLASSIFIED_RATE_LIMIT)      WAN_UNCLASSIFIED_RATE_LIMIT=$arg2 ;;
                WAN_UNCLASSIFIED_CEIL_LIMIT)      WAN_UNCLASSIFIED_CEIL_LIMIT=$arg2 ;;
                GW_TO_LAN_RATE_LIMIT)             GW_TO_LAN_RATE_LIMIT=$arg2 ;;
                GW_TO_LAN_CEIL_LIMIT)             GW_TO_LAN_CEIL_LIMIT=$arg2 ;;
                GW_TO_WAN_RATE_LIMIT)             GW_TO_WAN_RATE_LIMIT=$arg2 ;;
                GW_TO_WAN_CEIL_LIMIT)             GW_TO_WAN_CEIL_LIMIT=$arg2 ;;
                GW_TO_LAN_PRIORITY)               GW_TO_LAN_PRIORITY=$arg2 ;;
                GW_TO_WAN_PRIORITY)               GW_TO_WAN_PRIORITY=$arg2 ;;
                LAN_UNCLASSIFIED_PRIORITY)        LAN_UNCLASSIFIED_PRIORITY=$arg2 ;;
                WAN_UNCLASSIFIED_PRIORITY)        WAN_UNCLASSIFIED_PRIORITY=$arg2 ;;
                LAN_HOSTS_PRIORITY)               LAN_HOSTS_PRIORITY=$arg2 ;;
                WAN_HOSTS_PRIORITY)               WAN_HOSTS_PRIORITY=$arg2 ;;
                esac
        done < <(grep -v \# "$confdir/$shaper_file")
        IFS=$delimiter

        : "${LAN_INTERFACE_SPEED_LIMIT:=$DEFAULT_LAN_INTERFACE_SPEED_LIMIT}"
        : "${ISP_RX_LIMIT:=$DEFAULT_ISP_RX_LIMIT}"
        : "${ISP_TX_LIMIT:=$DEFAULT_ISP_TX_LIMIT}"
        : "${LAN_UNCLASSIFIED_RATE_LIMIT:=$DEFAULT_LAN_UNCLASSIFIED_RATE_LIMIT}"
        : "${LAN_UNCLASSIFIED_CEIL_LIMIT:=$DEFAULT_LAN_UNCLASSIFIED_CEIL_LIMIT}"
        : "${WAN_UNCLASSIFIED_RATE_LIMIT:=$DEFAULT_WAN_UNCLASSIFIED_RATE_LIMIT}"
        : "${WAN_UNCLASSIFIED_CEIL_LIMIT:=$DEFAULT_WAN_UNCLASSIFIED_CEIL_LIMIT}"
        : "${GW_TO_LAN_RATE_LIMIT:=$DEFAULT_GW_TO_LAN_RATE_LIMIT}"
        : "${GW_TO_LAN_CEIL_LIMIT:=$DEFAULT_GW_TO_LAN_CEIL_LIMIT}"
        : "${GW_TO_WAN_RATE_LIMIT:=$DEFAULT_GW_TO_WAN_RATE_LIMIT}"
        : "${GW_TO_WAN_CEIL_LIMIT:=$DEFAULT_GW_TO_WAN_CEIL_LIMIT}"
        : "${GW_TO_LAN_PRIORITY:=$DEFAULT_GW_TO_LAN_PRIORITY}"
        : "${GW_TO_WAN_PRIORITY:=$DEFAULT_GW_TO_WAN_PRIORITY}"
        : "${LAN_UNCLASSIFIED_PRIORITY:=$DEFAULT_LAN_UNCLASSIFIED_PRIORITY}"
        : "${WAN_UNCLASSIFIED_PRIORITY:=$DEFAULT_WAN_UNCLASSIFIED_PRIORITY}"
        : "${LAN_HOSTS_PRIORITY:=$DEFAULT_LAN_HOSTS_PRIORITY}"
        : "${WAN_HOSTS_PRIORITY:=$DEFAULT_WAN_HOSTS_PRIORITY}"

        Log "debug" LAN_INTERFACE_SPEED_LIMIT=$LAN_INTERFACE_SPEED_LIMIT
        Log "debug" ISP_RX_LIMIT=$ISP_RX_LIMIT
        Log "debug" ISP_TX_LIMIT=$ISP_TX_LIMIT
        Log "debug" LAN_UNCLASSIFIED_RATE_LIMIT=$LAN_UNCLASSIFIED_RATE_LIMIT
        Log "debug" LAN_UNCLASSIFIED_CEIL_LIMIT=$LAN_UNCLASSIFIED_CEIL_LIMIT
        Log "debug" WAN_UNCLASSIFIED_RATE_LIMIT=$WAN_UNCLASSIFIED_RATE_LIMIT
        Log "debug" WAN_UNCLASSIFIED_CEIL_LIMIT=$WAN_UNCLASSIFIED_CEIL_LIMIT
        Log "debug" GW_TO_LAN_RATE_LIMIT=$GW_TO_LAN_RATE_LIMIT
        Log "debug" GW_TO_LAN_CEIL_LIMIT=$GW_TO_LAN_CEIL_LIMIT
        Log "debug" GW_TO_WAN_RATE_LIMIT=$GW_TO_WAN_RATE_LIMIT
        Log "debug" GW_TO_WAN_CEIL_LIMIT=$GW_TO_WAN_CEIL_LIMIT
        Log "debug" GW_TO_LAN_PRIORITY=$GW_TO_LAN_PRIORITY
        Log "debug" GW_TO_WAN_PRIORITY=$GW_TO_WAN_PRIORITY
        Log "debug" LAN_UNCLASSIFIED_PRIORITY=$LAN_UNCLASSIFIED_PRIORITY
        Log "debug" WAN_UNCLASSIFIED_PRIORITY=$WAN_UNCLASSIFIED_PRIORITY
        Log "debug" LAN_HOSTS_PRIORITY=$LAN_HOSTS_PRIORITY
        Log "debug" WAN_HOSTS_PRIORITY=$WAN_HOSTS_PRIORITY


        #To WAN
        Log "debug" "Set limit for all traffic from WAN to Internet"
        tc qdisc add dev "$WAN" root handle 2:0 htb default 3 r2q 1
        tc class add dev "$WAN" parent 2:0 classid 2:1 htb rate "$ISP_TX_LIMIT" ceil "$ISP_TX_LIMIT" burst 2000000 quantum 1514

        Log "debug" "Set limit for traffic from GATEWAY to WAN"
        if [[ -n $BURST ]]; then
            tc class add dev "$WAN" parent 2:1 classid 2:4 htb rate "$GW_TO_WAN_RATE_LIMIT" ceil "$GW_TO_WAN_CEIL_LIMIT" burst "$BURST" prio "$GW_TO_WAN_PRIORITY" quantum 1514
        else
            tc class add dev "$WAN" parent 2:1 classid 2:4 htb rate "$GW_TO_WAN_RATE_LIMIT" ceil "$GW_TO_WAN_CEIL_LIMIT" prio "$GW_TO_WAN_PRIORITY" quantum 1514            
        fi
        tc qdisc add dev "$WAN" parent 2:4 fq_codel memory_limit 32Mb
        iptables -t mangle -A OUTPUT -o "$WAN" -j CLASSIFY --set-class 2:4

        #To LAN
        Log "debug" "Set global limit for LAN interface"
        tc qdisc add dev "$LAN" root handle 1:0 htb default 3 r2q 1
        tc class add dev "$LAN" parent 1:0 classid 1:1 htb rate "$LAN_INTERFACE_SPEED_LIMIT" ceil "$LAN_INTERFACE_SPEED_LIMIT" burst 1250000 quantum 1514

        Log "debug" "Set limit for all traffic from Internet to LAN"
        tc class add dev "$LAN" parent 1:1 classid 1:2 htb rate 950000kbit ceil 950000kbit burst 1187500 quantum 1514


        Log "debug" "Set limit for traffic from GATEWAY to LAN"
        if [[ -n $BURST ]]; then
           tc class add dev "$LAN" parent 1:1 classid 1:4 htb rate "$GW_TO_LAN_RATE_LIMIT" ceil "$GW_TO_LAN_CEIL_LIMIT" burst "$BURST" prio "$GW_TO_LAN_PRIORITY" quantum 1514
        else
           tc class add dev "$LAN" parent 1:1 classid 1:4 htb rate "$GW_TO_LAN_RATE_LIMIT" ceil "$GW_TO_LAN_CEIL_LIMIT" prio "$GW_TO_LAN_PRIORITY" quantum 1514        
        fi
        tc qdisc add dev "$LAN" parent 1:4 fq_codel memory_limit 32Mb
        iptables -t mangle -A OUTPUT -o "$LAN" -j CLASSIFY --set-class 1:4


        #To and from CUSTOMERS
        Log "debug" "Set limit for customers host"

        declare -A nets
        while read -r type ip; do
            [[ $type == filter ]] || continue
            nets["${ip%.*}"]=1
        done < "$confdir/$shaper_file"

        for net in "${!nets[@]}"; do
            iptables -t mangle -N "COUNTERSIN$net"
            iptables -t mangle -N "COUNTERSOUT$net"
            iptables -t mangle -I FORWARD -i "$WAN" -d "$net.0/24" -j "COUNTERSIN$net"
            iptables -t mangle -I FORWARD -o "$WAN" -s "$net.0/24" -j "COUNTERSOUT$net"
        done

        h=99
        while read arg1 arg2 arg3 arg4; do
            if [ "$arg1" = "customer" ]; then
                let h=$h+1
            elif [ "$arg1" = "class_up" ]; then
                rate=${arg2%kbit}
                CUSTOMER_UP_BURST=$(( $rate * 125 / 10 ))
                ceil=${arg3%kbit}
                CUSTOMER_UP_CBURST=$(( $ceil * 125 / 10 ))
                if ! check_interfaces_up "$WAN"; then
                    Log "error" "Interface $WAN check failed: skipping traffic shaping configuration."
                    return 1
                fi
                #Log "debug" "Configure tc class for $h on $WAN"
                tc class add dev "$WAN" parent 2:1 classid 2:"$h" htb rate "$arg2" ceil "$arg3" burst "${CUSTOMER_UP_BURST}"b cburst "${CUSTOMER_UP_CBURST}"b prio "$WAN_HOSTS_PRIORITY" quantum 1514
                tc qdisc add dev "$WAN" parent 2:"$h" fq_codel memory_limit 4Mb

            elif [ "$arg1" = "class_down" ]; then
                rate=${arg2%kbit}
                CUSTOMER_DOWN_BURST=$(( $rate * 125 / 10 ))
                ceil=${arg3%kbit}
                CUSTOMER_DOWN_CBURST=$(( $ceil * 125 / 10 ))
                if ! check_interfaces_up "$LAN"; then
                    Log "error" "Interface $LAN check failed: skipping traffic shaping configuration."
                    return 1
                fi
                #Log "debug" "Configure tc class for $h on $LAN"
                tc class add dev "$LAN" parent 1:2 classid 1:"$h" htb rate "$arg2" ceil "$arg3" burst "${CUSTOMER_DOWN_BURST}"b cburst "${CUSTOMER_DOWN_CBURST}"b prio "$LAN_HOSTS_PRIORITY" quantum 1514
                tc qdisc add dev "$LAN" parent 1:"$h" fq_codel memory_limit 4Mb

            elif [ "$arg1" = "filter" ]; then
                #Log "debug" "Configure iptables mangle with --set-class for $h"
                subnet=${arg2%.*}
                iptables -t mangle -A COUNTERSOUT"$subnet" -s "$arg2" -j CLASSIFY --set-class 2:"$h";
                iptables -t mangle -A COUNTERSIN"$subnet" -d "$arg2" -j CLASSIFY --set-class 1:"$h";
            fi
        done < <(grep -v \# $confdir/$shaper_file)


        Log "debug" "Set default limit for traffic from WAN to Internet"
        tc class add dev "$WAN" parent 2:1 classid 2:3 htb rate "$WAN_UNCLASSIFIED_RATE_LIMIT" ceil "$WAN_UNCLASSIFIED_CEIL_LIMIT" prio "$WAN_UNCLASSIFIED_PRIORITY" quantum 1514
        tc qdisc add dev "$WAN" parent 2:3 fq_codel memory_limit 1Mb

        Log "debug" "Set default limit for traffic from Internet to LAN"
        tc class add dev "$LAN" parent 1:1 classid 1:3 htb rate "$LAN_UNCLASSIFIED_RATE_LIMIT" ceil "$LAN_UNCLASSIFIED_CEIL_LIMIT" prio "$LAN_UNCLASSIFIED_PRIORITY" quantum 1514
        tc qdisc add dev "$LAN" parent 1:3 fq_codel memory_limit 1Mb


    elif [ "$1" = "stats" ]; then

        get_counters

    elif [ "$1" = "status" ]; then

        #iptables -t mangle -w 2 -nvL
        echo
        echo "$LAN interface"
        echo "----------------"
        for TC_OPTIONS in qdisc class filter; do
            if [ ! -z "$LAN" ]; then
                echo
                echo "$TC_OPTIONS"
                echo "------"
                tc "$TC_OPTIONS" show dev "$LAN"
            fi
        done

        echo
        echo "$WAN interface"
        echo "----------------"
        for TC_OPTIONS in qdisc class filter; do
            if [ ! -z "$WAN" ]; then
                echo
                echo "$TC_OPTIONS"
                echo "------"
                tc "$TC_OPTIONS" show dev "$WAN"
            fi
        done
    fi
}

create_fw_hashtables() {
    #hashtable for granted host
    current_ipset_list=$(ipset -q --list fw_ip)
    if ([ "$current_ipset_list" = "" ]); then
        ipset create fw_ip hash:ip hashsize 2048
    fi

    #hashtable for denied host
    current_ipset_list=$(ipset -q --list fw_denied_hosts)
    if ([ "$current_ipset_list" = "" ]); then
        ipset create fw_denied_hosts hash:ip hashsize 1024
    fi

    #hashtable for warned host
    current_ipset_list=$(ipset -q --list fw_warned_hosts)
    if ([ "$current_ipset_list" = "" ]); then
        ipset create fw_warned_hosts hash:ip hashsize 2048
    fi

    #hashtable for blacklisted host/networks
    current_ipset_list=$(ipset -q --list fw_time_blacklist)
    if ([ "$current_ipset_list" = "" ]); then
        ipset create fw_time_blacklist hash:net hashsize 2048 timeout 900
        ipset create fw_permanent_blacklist hash:net hashsize 2048
    fi

    #hashtable for permanent banned dst ports on LAN interface
    current_ipset_list=$(ipset -q --list fw_lan_banned_dst_ports)
    if ([ "$current_ipset_list" = "" ]); then
        ipset create fw_lan_banned_dst_ports bitmap:port range 0-65535
    fi

    #hashtable for permanent banned dst ports on WAN interface
    current_ipset_list=$(ipset -q --list fw_wan_banned_dst_ports)
    if ([ "$current_ipset_list" = "" ]); then
        ipset create fw_wan_banned_dst_ports bitmap:port range 0-65535
    fi

    #hashtable for ddos protected dst ports on LAN interface
    current_ipset_list=$(ipset -q --list fw_lan_ddos_protected_ports)
    if ([ "$current_ipset_list" = "" ]); then
        ipset create fw_lan_ddos_protected_ports bitmap:port range 0-65535
    fi

    #hashtable for ddos source from WAN interface
    current_ipset_list=$(ipset -q --list fw_wan_ddos_source)
    if ([ "$current_ipset_list" = "" ]); then
        ipset create fw_wan_ddos_source hash:ip hashsize 2048 timeout 900
    fi

    #hashtable for fw operator IPs from WAN interface
    current_ipset_list=$(ipset -q --list fw_wan_operator_ips)
    if ([ "$current_ipset_list" = "" ]); then
        ipset create fw_wan_operator_ips hash:ip hashsize 2048
    fi

    #hashtable for fw operator IPs from LAN interface
    current_ipset_list=$(ipset -q --list fw_lan_operator_ips)
    if ([ "$current_ipset_list" = "" ]); then
        ipset create fw_lan_operator_ips hash:ip hashsize 2048
    fi

    #hashtable for nat1-n host
    while read nat_name ip; do
        ipset create "$nat_name" hash:ip hashsize 1024
    done <"$confdir"/"$nat_1n_ip_file"
    Log "debug" "create_fw_hashtables OK"
}

create_tmp_hashtables() {
    #create tmp hashtable for granted host
    ipset create fw_ip.tmp hash:ip hashsize 2048

    #create tmp hashtable for denied host
    ipset create fw_denied_hosts.tmp hash:ip hashsize 1024

    #create tmp hashtable for warned host
    ipset create fw_warned_hosts.tmp hash:ip hashsize 2048

    #create tmp hashtable for blacklisted hosts/networks
    ipset create fw_permanent_blacklist.tmp hash:net hashsize 2048

    #create tmp hashtable for banned dst ports on LAN interface
    ipset create fw_lan_banned_dst_ports.tmp bitmap:port range 0-65535

    #create tmp hashtable for banned dst ports on WAN interface
    ipset create fw_wan_banned_dst_ports.tmp bitmap:port range 0-65535

    #create tmp hashtable for DDoS protected dst ports on LAN interface
    ipset create fw_lan_ddos_protected_ports.tmp bitmap:port range 0-65535

    #create tmp hashtable for nat1-n host
    while read nat_name ip; do
        ipset create "$nat_name".tmp hash:ip hashsize 1024
    done <"$confdir"/"$nat_1n_ip_file"

    #hashtable for fw operator IPs from LAN interface
    ipset create fw_lan_operator_ips.tmp hash:ip hashsize 1024

    #hashtable for fw operator IPs from WAN interface
    ipset create fw_wan_operator_ips.tmp hash:ip hashsize 1024

    Log "debug" "create_tmp_hashtables OK"
}

destroy_tmp_hashtables() {
    for ipsetlist in $(ipset list -n|grep -E "\.tmp$")
    do
        ipset destroy $ipsetlist
    done
    Log "debug" "destroy_tmp_hashtables OK"
}

load_tmp_fw_ip_hashtable() {
